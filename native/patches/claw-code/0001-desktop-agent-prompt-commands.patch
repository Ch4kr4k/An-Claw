+/// The prompt of a prompt-backed slash command typed in the app, with its
+/// arguments as the focus; `None` for anything else.
+fn expand_prompt_command(text: &str) -> Option<String> {
+    let rest = text.trim().strip_prefix('/')?;
+    let (word, args) = rest.split_once(char::is_whitespace).unwrap_or((rest, ""));
+    if word.is_empty() || !word.chars().all(|c| c.is_ascii_lowercase() || c == '-') {
+        return None;
+    }
+    crate::repl_commands::prompt_for_command(word, Some(args))
+}
