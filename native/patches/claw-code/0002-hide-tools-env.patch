+/// Tools a host app hides from the model (`CLAW_HIDE_TOOLS`, comma-separated
+/// names, case-insensitive): an-claw on a phone drops desktop-only tools (X11,
+/// Browser, COM, …) so a slow local model reads thousands fewer prompt tokens.
+/// Unlike `--allowedTools`, MCP tools stay available.
+fn hidden_by_host(name: &str) -> bool {
+    static HIDDEN: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    HIDDEN
+        .get_or_init(|| {
+            env::var("CLAW_HIDE_TOOLS")
+                .unwrap_or_default()
+                .split(',')
+                .map(|n| n.trim().to_ascii_lowercase())
+                .filter(|n| !n.is_empty())
+                .collect()
+        })
+        .iter()
+        .any(|hidden| hidden.eq_ignore_ascii_case(name))
+}
